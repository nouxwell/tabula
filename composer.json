{
    "name": "balin/tabula",
    "description": "Şema tabanlı tablo verisi dışa/içe aktarma: Excel, CSV, PDF. Tek şema, üç yön.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Hüseyin Niyazi Balın",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.5",
        "phpoffice/phpspreadsheet": "^5.1"
    },
    "require-dev": {
        "doctrine/orm": "^3.3",
        "dompdf/dompdf": "^3.1",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "symfony/config": "^7.2|^8.0",
        "symfony/dependency-injection": "^7.2|^8.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "symfony/translation": "^7.2|^8.0",
        "symfony/translation-contracts": "^3.5"
    },
    "suggest": {
        "dompdf/dompdf": "Format::Pdf ile PDF yazmak için",
        "doctrine/orm": "DoctrineSource ile QueryBuilder üzerinden okumak için",
        "symfony/http-kernel": "TabulaBundle (Symfony köprüsü) için",
        "symfony/translation-contracts": "SymfonyTranslator adaptörü için"
    },
    "autoload": {
        "psr-4": {
            "Balin\\Tabula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Balin\\Tabula\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
