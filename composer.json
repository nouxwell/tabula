{
    "name": "balin/tabula",
    "description": "Schema-driven tabular export and import for Excel, CSV and PDF. One schema, three directions.",
    "type": "library",
    "keywords": [
        "excel",
        "xlsx",
        "csv",
        "pdf",
        "export",
        "import",
        "spreadsheet",
        "schema",
        "symfony"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Hüseyin Niyazi Balın",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.5",
        "phpoffice/phpspreadsheet": "^5.1"
    },
    "require-dev": {
        "doctrine/orm": "^3.3",
        "dompdf/dompdf": "^3.1",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "symfony/config": "^7.2|^8.0",
        "symfony/dependency-injection": "^7.2|^8.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "symfony/translation": "^7.2|^8.0",
        "symfony/translation-contracts": "^3.5"
    },
    "suggest": {
        "dompdf/dompdf": "Required to write PDF output with Format::Pdf",
        "doctrine/orm": "Required by DoctrineSource to read through a QueryBuilder",
        "symfony/http-kernel": "Required by TabulaBundle, the Symfony bridge",
        "symfony/translation": "Lets SymfonyTranslator ask the catalogue which domain defines a key",
        "symfony/translation-contracts": "Required by the SymfonyTranslator adapter"
    },
    "autoload": {
        "psr-4": {
            "Balin\\Tabula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Balin\\Tabula\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
